{
  "name": "manhole-card-map",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "import:gkp": "node scripts/import-gkp-data.js",
    "verify:image-codes": "node scripts/verify-card-image-codes.js",
    "verify:image-codes:changed": "node scripts/verify-card-image-codes.js --changed",
    "apply:image-codes": "node scripts/verify-card-image-codes.js --apply --strict",
    "import:forms": "node scripts/import-form-requests.js",
    "normalize:links": "node scripts/normalize-source-links.js",
    "sync:gkp-review-issue": "node scripts/sync-gkp-review-issue.js",
    "acknowledge:gkp-review": "node scripts/acknowledge-gkp-review-candidates.js",
    "audit:geocode-precision": "node scripts/list-geocode-precision-candidates.js",
    "audit:geocode-precision:changed": "CHANGED_ONLY=1 node scripts/list-geocode-precision-candidates.js",
    "audit:geocode-review:issues": "GEOCODE_AUDIT_SCOPE=review-issues node scripts/list-geocode-precision-candidates.js --all",
    "audit:geocode-candidates": "GEOCODE_AUDIT_SCOPE=review-issues node scripts/enrich-geocode-precision-candidates.js",
    "audit:geocode-candidates:changed": "GEOCODE_AUDIT_SCOPE=changed-targets CHANGED_ONLY=1 FETCH_PLACES=1 FETCH_WEB_SEARCH=1 FETCH_OFFICIAL_MAPS=1 FETCH_NOMINATIM=1 MAX_NOMINATIM_REQUESTS=10 node scripts/enrich-geocode-precision-candidates.js",
    "audit:geocode-candidates:issues": "GEOCODE_AUDIT_SCOPE=review-issues FETCH_PLACES=1 FETCH_WEB_SEARCH=1 FETCH_OFFICIAL_MAPS=1 FETCH_NOMINATIM=1 MAX_NOMINATIM_REQUESTS=10 node scripts/enrich-geocode-precision-candidates.js",
    "report:geocode-candidates": "node scripts/summarize-geocode-review-candidates.js",
    "audit:geocode-official-evidence": "node scripts/audit-geocode-official-evidence.js",
    "audit:geocode-nominatim-coverage": "node scripts/report-nominatim-geocode-coverage.js",
    "audit:geocode-nominatim-coverage:changed": "CHANGED_ONLY=1 node scripts/report-nominatim-geocode-coverage.js",
    "apply:geocode-candidates": "node scripts/apply-geocode-candidate-updates.js",
    "prepare:geocode-approvals": "node scripts/prepare-geocode-review-approvals.js",
    "sync:geocode-review-cache": "node scripts/sync-reviewed-geocode-cache.js",
    "update:codes": "node scripts/update-location-codes.js",
    "geocode": "node scripts/geocode-locations.js",
    "generate:icons": "node scripts/generate-icons.js",
    "validate:data": "node scripts/validate-data.js",
    "test": "node --test"
  }
}
